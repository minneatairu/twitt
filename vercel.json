{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "static",
  "functions": {
    "api/index.py": { "maxDuration": 60, "includeFiles": "app.py" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' https://pbs.twimg.com; frame-ancestors 'none'" }
      ]
    }
  ]
}
